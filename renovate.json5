{
	extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
	minimumReleaseAge: "14 days",
	dependencyDashboard: true,
	packageRules: [
		{
			groupName: "npm dependencies",
			description: "Bundle all non-major npm updates into one weekly update",
			matchDatasources: ["npm"],
			matchUpdateTypes: ["minor", "patch", "pin", "digest"],
			schedule: ["before 9am on tuesday"],
		},
		{
			groupName: "github actions",
			description: "Bundle all GitHub Actions updates into one weekly update",
			matchManagers: ["github-actions"],
			matchUpdateTypes: ["major", "minor", "patch", "pin", "digest"],
			schedule: ["before 9am on tuesday"],
		},
		{
			description: "Major updates flow normally, gated only by the minimumReleaseAge",
			matchUpdateTypes: ["major"],
		},
		{
			groupName: "docker and node updates",
			description: "Bundle Docker image and Node.js version updates together",
			matchDatasources: ["docker", "node"],
		},
		{
			// See: https://github.com/renovatebot/renovate/discussions/23889
			description: "Disable all Playwright updates",
			matchPackageNames: [
				"@playwright/test",
				"mcr.microsoft.com/playwright",
			],
			enabled: false,
		},
		{
			description: "Update custom packages when available",
			groupName: "custom package updates",
			matchPackageNames: ["@iveelsm/*", "astro-font-loader"],
			minimumReleaseAge: "0 days",
		},
	],
}
